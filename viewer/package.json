{
  "name": "yt-segment-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side-only viewer for the unsegmented YouTube video with transcript.json subtitles and segments.json navigation",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch --serve",
    "bundle": "tsc --noEmit && node scripts/build.mjs --bundle",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
